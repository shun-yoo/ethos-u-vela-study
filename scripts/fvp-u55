#!/usr/bin/env bash
# Corstone-300 FVP (Ethos-U55) 실행. FVP 전용 Python 3.9 환경은 이 프로세스에만 적용된다.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FVP_DIR="$ROOT/tools/FVP_Corstone_SSE-300"
source "$FVP_DIR/scripts/runtime.sh"
exec "$FVP_DIR/models/Linux64_GCC-9.3/FVP_Corstone_SSE-300_Ethos-U55" "$@"
